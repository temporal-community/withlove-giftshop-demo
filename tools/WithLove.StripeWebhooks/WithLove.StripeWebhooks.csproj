<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <TargetFramework>net10.0</TargetFramework>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
    <RootNamespace>WithLove.StripeWebhooks</RootNamespace>
  </PropertyGroup>

  <ItemGroup>
    <!--
      Stripe.net is referenced explicitly and pinned, NOT taken transitively through
      Stripe.Extensions.AspNetCore (src/WithLove.Web/WithLove.Web.csproj). The whole reason this is
      a .NET tool rather than curl+jq is that `api_version` on a created endpoint must equal
      StripeConfiguration.ApiVersion — so the version this tool compiles against is load-bearing and
      must not be decided by someone else's transitive resolution.

      Keep this in step with the Stripe.net that Stripe.Extensions.AspNetCore resolves in
      WithLove.Web. If they diverge, endpoints get stamped with a version the webhook handler will
      reject (ThrowOnWebhookApiVersionMismatch defaults to true).
    -->
    <PackageReference Include="Stripe.net" Version="52.4.0" />
  </ItemGroup>

  <ItemGroup>
    <InternalsVisibleTo Include="WithLove.StripeWebhooks.Tests" />
  </ItemGroup>
</Project>
