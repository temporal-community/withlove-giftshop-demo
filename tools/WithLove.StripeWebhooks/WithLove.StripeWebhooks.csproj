<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <TargetFramework>net10.0</TargetFramework>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
    <RootNamespace>WithLove.StripeWebhooks</RootNamespace>
  </PropertyGroup>

  <ItemGroup>
    <!-- Match the Stripe.net version used by WithLove.Web so webhook API versions agree. -->
    <PackageReference Include="Stripe.net" Version="52.4.0" />
  </ItemGroup>

  <ItemGroup>
    <InternalsVisibleTo Include="WithLove.StripeWebhooks.Tests" />
  </ItemGroup>
</Project>
