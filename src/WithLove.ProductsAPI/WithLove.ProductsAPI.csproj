<Project Sdk="Microsoft.NET.Sdk.Web">

    <PropertyGroup>
        <TargetFramework>net11.0</TargetFramework>
        <Nullable>enable</Nullable>
        <ImplicitUsings>enable</ImplicitUsings>
    </PropertyGroup>

    <ItemGroup>
        <InternalsVisibleTo Include="WithLove.ProductsAPI.Tests" />
    </ItemGroup>

    <ItemGroup>
        <!-- Entity Framework Core -->
        <PackageReference Include="Microsoft.EntityFrameworkCore" Version="11.0.0" />
<PackageReference Include="Microsoft.EntityFrameworkCore.SqlServer" Version="11.0.0" />

        <!-- Aspire Integration -->
        <PackageReference Include="Aspire.Microsoft.EntityFrameworkCore.SqlServer" Version="17.0.0" />

        <!-- OpenAPI & Documentation -->
        <PackageReference Include="Microsoft.AspNetCore.OpenApi" Version="11.0.0" />
        <PackageReference Include="Microsoft.OpenApi" Version="3.11.1" />
        <PackageReference Include="Microsoft.Extensions.AI" Version="11.0.0" />
        <PackageReference Include="Microsoft.Extensions.AI.OpenAI" Version="11.0.0" />
        <PackageReference Include="Microsoft.Extensions.Caching.StackExchangeRedis" Version="11.0.0" />
        <PackageReference Include="Scalar.AspNetCore" Version="3.0.1" />
        <PackageReference Include="Scalar.AspNetCore.Microsoft" Version="3.0.1" />

        <!-- Caching -->
        <PackageReference Include="ZiggyCreatures.FusionCache" Version="2.9.0" />
        <PackageReference Include="ZiggyCreatures.FusionCache.Backplane.StackExchangeRedis" Version="2.9.0" />
        <PackageReference Include="ZiggyCreatures.FusionCache.OpenTelemetry" Version="2.9.0" />
        <PackageReference Include="ZiggyCreatures.FusionCache.Serialization.SystemTextJson" Version="2.9.0" />

    </ItemGroup>

    <ItemGroup>
      <ProjectReference Include="..\WithLove.ServiceDefaults\WithLove.ServiceDefaults.csproj" />
      <ProjectReference Include="..\WithLove.Data\WithLove.Data.csproj" />
    </ItemGroup>

</Project>
