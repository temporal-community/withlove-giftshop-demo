<Project Sdk="Microsoft.NET.Sdk">

    <PropertyGroup>
        <OutputType>Exe</OutputType>
        <TargetFramework>net11.0</TargetFramework>
        <ImplicitUsings>enable</ImplicitUsings>
        <Nullable>enable</Nullable>
        <NoWarn>$(NoWarn);ASPIRE010</NoWarn>
        <UserSecretsId>909fc674-6133-45e7-86cc-a46a15048bf4</UserSecretsId>
    </PropertyGroup>

    <ItemGroup>
        <!-- ValidateStripeWebhookSecret is a pure function reached only from a publish-time
             pipeline step. Booting the AppHost to exercise it would need real secrets, so the
             test project calls it directly. -->
        <InternalsVisibleTo Include="WithLove.ProductsAPI.Tests" />
        <InternalsVisibleTo Include="WithLove.StripeWebhooks.Tests" />
    </ItemGroup>

    <ItemGroup>
      <PackageReference Include="Aspire.Hosting.AppHost" Version="17.0.0" />
      <PackageReference Include="Aspire.Hosting.Dotnet" Version="17.0.0" />
      <PackageReference Include="Aspire.Hosting.Azure.AppContainers" Version="17.0.0" />
      <PackageReference Include="Aspire.Hosting.Azure.KeyVault" Version="17.0.0" />
      <PackageReference Include="Aspire.Hosting.Azure.Redis" Version="17.0.0" />
      <PackageReference Include="Aspire.Hosting.Azure.Sql" Version="17.0.0" />
      <PackageReference Include="Aspire.Hosting.Redis" Version="17.0.0" />
      <PackageReference Include="Aspire.Hosting.SqlServer" Version="17.0.0" />
      <PackageReference Include="CommunityToolkit.Aspire.Hosting.SqlServer.Extensions" Version="13.6.1" />
      <PackageReference Include="Stripe.Hosting.Aspire" Version="0.6.4" />
      <PackageReference Include="TemporalCommunity.Aspire.Hosting" Version="0.5.2" />
      <PackageReference Include="Temporalio" Version="1.22.0" />
    </ItemGroup>

</Project>
