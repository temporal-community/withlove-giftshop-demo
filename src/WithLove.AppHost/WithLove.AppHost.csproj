<Project Sdk="Aspire.AppHost.Sdk/13.5.3">

    <PropertyGroup>
        <OutputType>Exe</OutputType>
        <TargetFramework>net10.0</TargetFramework>
        <ImplicitUsings>enable</ImplicitUsings>
        <Nullable>enable</Nullable>
        <!-- Preserve direct dotnet/IDE AppHost execution; evaluate CLI bundle delegation separately. -->
        <AspireUseCliBundle>false</AspireUseCliBundle>
        <NoWarn>$(NoWarn);ASPIRE010</NoWarn>
        <UserSecretsId>909fc674-6133-45e7-86cc-a46a15048bf4</UserSecretsId>
    </PropertyGroup>

    <ItemGroup>
        <!-- ValidateStripeWebhookSecret is a pure function reached only from a publish-time
             pipeline step. Booting the AppHost to exercise it would need real secrets, so the
             test project calls it directly. -->
        <InternalsVisibleTo Include="WithLove.ProductsAPI.Tests" />
        <InternalsVisibleTo Include="WithLove.Telemetry.Tests" />
        <InternalsVisibleTo Include="WithLove.StripeWebhooks.Tests" />
    </ItemGroup>

    <ItemGroup>
        <ProjectReference Include="..\Arize.Aspire.Hosting\Arize.Aspire.Hosting.csproj" IsAspireProjectResource="false" />
        <ProjectReference Include="..\WithLove.ProductsAPI\WithLove.ProductsAPI.csproj" />
    <ProjectReference Include="..\WithLove.Web\WithLove.Web.csproj" />
        <ProjectReference Include="..\WithLove.WorkflowServer\WithLove.WorkflowServer.csproj" />
    </ItemGroup>

    <ItemGroup>
      <PackageReference Include="Aspire.Hosting.Azure.AppContainers" Version="13.5.3" />
      <PackageReference Include="Aspire.Hosting.Azure.KeyVault" Version="13.5.3" />
      <PackageReference Include="Aspire.Hosting.Azure.Redis" Version="13.5.3" />
      <PackageReference Include="Aspire.Hosting.Azure.Sql" Version="13.5.3" />
      <PackageReference Include="Aspire.Hosting.Redis" Version="13.5.3" />
      <PackageReference Include="Aspire.Hosting.SqlServer" Version="13.5.3" />
      <PackageReference Include="CommunityToolkit.Aspire.Hosting.SqlServer.Extensions" Version="13.5.0" />
      <PackageReference Include="Stripe.Hosting.Aspire" Version="0.6.4" />
      <PackageReference Include="TemporalCommunity.Aspire.Hosting" Version="0.4.0" />
      <PackageReference Include="Temporalio" Version="1.18.0" />
    </ItemGroup>

</Project>
