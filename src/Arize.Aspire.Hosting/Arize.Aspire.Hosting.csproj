<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
    <IsPackable>true</IsPackable>
    <PackageId>Arize.Aspire.Hosting</PackageId>
    <Description>Aspire hosting integration for Arize Phoenix and Arize AX trace destinations.</Description>
    <PackageTags>aspire;arize;phoenix;ax;opentelemetry</PackageTags>
  </PropertyGroup>
  <ItemGroup>
    <PackageReference Include="Aspire.Hosting" Version="13.5.4" />
  </ItemGroup>
</Project>
