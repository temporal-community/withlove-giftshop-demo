# ---------------------------------------------------------------------------
# WithLove Azure deployment secrets — EXAMPLE / TEMPLATE
# ---------------------------------------------------------------------------
# Copy this file to .secrets.env and fill in your real values.
# .secrets.env is gitignored and must never be committed.
#
# Usage:  just deploy
#         OR:    source .secrets.env && aspire deploy \
#                    --apphost src/WithLove.AppHost/WithLove.AppHost.csproj \
#                    --environment azureprod --non-interactive
# ---------------------------------------------------------------------------

# Azure targeting
export Azure__SubscriptionId="<your-subscription-id>"
export Azure__TenantId="<your-tenant-id>"
export Azure__Location="eastus"
export Azure__ResourceGroup="rg-aspire-withlove"

# OpenAI
export Parameters__openai_api_key="<your-openai-api-key>"

# Arize AX trace export. Use the regional endpoint shown by the AX connect page.
export ARIZE_OTLP_ENDPOINT="<your-arize-ax-otlp-endpoint>"
export ARIZE_API_KEY="<your-arize-ax-api-key>"
export ARIZE_SPACE_ID="<your-arize-ax-space-id>"

# Redis container authentication
# Generate once with: openssl rand -hex 24
export Parameters__redis_password="<stable-random-password>"

# Stripe
export Parameters__stripe_api_key="<your-stripe-secret-key>"
export Parameters__stripe_public_key="<your-stripe-publishable-key>"
# The Azure deploy recipe creates and records this after the shopSite URL exists.
# Do not set Parameters__stripe_webhook_secret manually.

# Temporal Cloud
export Parameters__temporal_address="<namespace.account.tmprl.cloud:7233>"
export Parameters__temporal_namespace="<your-temporal-namespace>"
export Parameters__temporal_api_key="<your-temporal-api-key>"
